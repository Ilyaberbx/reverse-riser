<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Glacier Riser @VERSION@</title>
    <organization>com.icecoldsound</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <volume-check><allowed-os-versions><os-version min="10.13"/></allowed-os-versions></volume-check>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="standalone"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plug-in" description="For Ableton Live, FL Studio, Cubase, Reaper, Bitwig, Studio One and most other DAWs. Installs to /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.icecoldsound.glacierriser.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (AU)" description="For Logic Pro and GarageBand. Installs to /Library/Audio/Plug-Ins/Components.">
        <pkg-ref id="com.icecoldsound.glacierriser.au"/>
    </choice>
    <choice id="standalone" title="Standalone app" description="Use Glacier Riser without a DAW. Installs to /Applications.">
        <pkg-ref id="com.icecoldsound.glacierriser.standalone"/>
    </choice>
    <pkg-ref id="com.icecoldsound.glacierriser.vst3" version="@VERSION@">VST3.pkg</pkg-ref>
    <pkg-ref id="com.icecoldsound.glacierriser.au" version="@VERSION@">AU.pkg</pkg-ref>
    <pkg-ref id="com.icecoldsound.glacierriser.standalone" version="@VERSION@">Standalone.pkg</pkg-ref>
</installer-gui-script>
